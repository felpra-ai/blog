---
// 툰 첫 화면 — 시리즈별 최신 회차 (ko·en 공용)
import { getCollection } from 'astro:content';
import ToonCard from './ToonCard.astro';
import { TOON_SERIES } from '../data/toonSeries';
interface Props { lang: 'ko' | 'en' }
const { lang } = Astro.props;
const all = (await getCollection('toon', ({ data }) => !data.draft && data.lang === lang))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const pfx = lang === 'en' ? '/en' : '';
const series = TOON_SERIES.map((s) => ({ ...s, eps: all.filter((e) => e.data.series === s.id) }));
---
{series.map((s) => (
  <section class="series container-wide">
    <div class="s-head">
      <img src={s.face} alt="" width="44" height="44" />
      <div>
        <h2><a href={`${pfx}/toon/series/${s.id}/`}>{lang === 'en' ? s.en : s.ko}</a></h2>
        <p class="muted">{lang === 'en' ? s.enDesc : s.koDesc}</p>
      </div>
      {s.eps.length > 0 && <a class="all" href={`${pfx}/toon/series/${s.id}/`}>{lang === 'en' ? `All ${s.eps.length} episodes →` : `전체 ${s.eps.length}화 →`}</a>}
    </div>
    {s.eps.length === 0
      ? <p class="muted empty">{lang === 'en' ? 'First episode coming soon.' : '첫 화 준비 중.'}</p>
      : <div class="grid">{s.eps.slice(0, 6).map((e) => <ToonCard entry={e} lang={lang} />)}</div>}
  </section>
))}
<style>
  .series { padding: 18px 24px 28px; }
  .s-head { display:flex; align-items:center; gap:12px; margin-bottom: 14px; }
  .s-head img { border-radius: 50%; background: var(--panel-bg); }
  .s-head h2 { font-size: 20px; font-weight: 700; margin: 0; }
  .s-head h2 a { color: var(--text); }
  .s-head p { margin: 2px 0 0; font-size: 13px; }
  .s-head .all { margin-left:auto; font-size: 13px; color: var(--amber); white-space:nowrap; }
  .grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
  .empty { padding: 8px 0 16px; }
</style>
