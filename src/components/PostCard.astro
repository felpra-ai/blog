---
import TagList from './TagList.astro';
export interface Props {
  href: string;
  title: string;
  description: string;
  date: Date;
  category: string;
  markets?: string[];
  tags?: string[];
}
const { href, title, description, date, category, markets = [], tags = [] } = Astro.props;
const dateLabel = date.toISOString().slice(0, 10);
---
<!-- 카드 전체를 <a> 로 감싸면 안의 태그 링크가 <a> 속 <a>(잘못된 HTML)가 된다 — 제목 링크를 카드 전체로 늘린다(2026-11-19). -->
<article class="card">
  <div class="top">
    <span class="cat eyebrow">{category}</span>
    <time class="muted" datetime={date.toISOString()}>{dateLabel}</time>
  </div>
  <h2><a class="stretch" href={href}>{title}</a></h2>
  <p class="desc muted">{description}</p>
  <div class="tagrow"><TagList markets={markets} tags={tags} /></div>
</article>

<style>
  .card { position:relative; display:block; padding: 22px 22px 20px; background: var(--panel-bg); border: 1px solid var(--border); border-radius: var(--radius-2xl); transition: transform .25s, box-shadow .3s, border-color .3s; }
  .card:hover { transform: translateY(-3px); border-color: rgba(212,168,83,0.4); box-shadow: 0 0 20px rgba(212,168,83,0.12); }
  .top { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px; font-size:11px; }
  .card h2 { font-size: 18px; font-weight: 600; line-height: 1.35; color: var(--text); margin-bottom: 8px; }
  .stretch { color: inherit; }
  .stretch::after { content:''; position:absolute; inset:0; border-radius: inherit; }
  .tagrow { position:relative; z-index:1; }
  .desc { font-size: 13px; line-height: 1.7; margin-bottom: 12px; }
</style>
