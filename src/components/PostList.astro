---
// 날짜별 목록 (홈·섹션 목록 공용). 마크업은 feedCore.renderDays 한 곳에서 만든다 —
// 홈 전체 기간 필터가 브라우저에서 같은 함수로 그리므로 스타일은 전역(.fd-*)이다.
import { groupDays, renderDays, type Entry, type Lang } from './feedCore';
export interface Props { posts: Entry[]; lang?: Lang; inline?: boolean }
const { posts, lang = 'ko', inline = false } = Astro.props;
const html = renderDays(groupDays(posts), lang, inline);
---
<div class="fd" set:html={html} />

<style is:global>
  .fd-day { margin-bottom: 20px; }
  .fd-head { display:flex; align-items:center; gap:10px; margin:0 0 6px; padding-bottom:6px; border-bottom:1px solid var(--border); }
  .fd-head time { font-family: var(--font-mono); font-size:13px; font-weight:600; color: var(--amber); letter-spacing:.5px; }
  .fd-n { font-size:11px; color: var(--text-muted); }
  .fd-lines { list-style:none; margin:0; padding:0; }
  .fd-line { display:flex; align-items:center; gap:12px; padding:7px 6px; border-bottom:1px solid color-mix(in srgb, var(--border) 55%, transparent); }
  .fd-line:last-child { border-bottom:none; }
  .fd-cat { flex:0 0 96px; font-size:10px; font-weight:600; letter-spacing:.6px; text-transform:uppercase; padding:3px 8px; border-radius:999px; text-align:center; border:1px solid var(--border); color: var(--text-muted); white-space:nowrap; }
  .fd-track-record { color:#d4a853; border-color: rgba(212,168,83,.4); }
  .fd-market { color:#5aa9e6; border-color: rgba(90,169,230,.4); }
  .fd-spotlight { color:#c98ae6; border-color: rgba(201,138,230,.4); }
  .fd-journal { color:#8a8f98; }
  .fd-toon { color:#e6a05a; border-color: rgba(230,160,90,.4); }
  .fd-chips { display:flex; flex-wrap:wrap; gap:6px; }
  .fd-chip { font-size:13px; padding:3px 12px; border:1px solid var(--border); border-radius:999px; color: var(--text); transition: border-color .15s, color .15s; }
  .fd-chip:hover { border-color: rgba(212,168,83,.5); color: var(--amber); }
  .fd-title { flex:1 1 auto; font-size:14px; color: var(--text); line-height:1.4; }
  .fd-title:hover { color: var(--amber); }
  .fd-mk { flex:0 0 auto; font-size:11px; color: var(--text-muted); }
  .fd-inline { list-style:none; margin:0; padding:0; }
  .fd-iday { display:flex; align-items:center; gap:16px; padding:8px 6px; border-bottom:1px solid color-mix(in srgb, var(--border) 55%, transparent); }
  .fd-iday time { flex:0 0 auto; font-family: var(--font-mono); font-size:13px; font-weight:600; color: var(--amber); letter-spacing:.5px; }
  @media (max-width:560px) {
    .fd-line { flex-wrap:wrap; gap:6px 10px; padding:8px 4px; }
    .fd-cat { flex-basis:auto; }
    .fd-title { flex-basis:100%; order:3; font-size:13px; }
  }
</style>
