---
// EN market 목록 — /market/ 의 영어판 쌍둥이. 본문·문구는 SectionPage.
import SectionPage from '../../../components/SectionPage.astro';
import { entries } from '../../../components/feedData';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return paginate(await entries('en', ['market']), { pageSize: 36 });
}
const { page } = Astro.props;
---
<SectionPage col="market" lang="en" page={page} />
