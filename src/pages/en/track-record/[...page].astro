---
// EN track-record 목록 — /track-record/ 의 영어판 쌍둥이. 본문·문구는 SectionPage.
import SectionPage from '../../../components/SectionPage.astro';
import { entries } from '../../../components/feedData';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return paginate(await entries('en', ['track-record']), { pageSize: 36 });
}
const { page } = Astro.props;
---
<SectionPage col="track-record" lang="en" page={page} />
