---
import PostLayout from '../../layouts/PostLayout.astro';

// Weekly ledger integrity anchor — generated by mac_admin ledger_anchor_publisher. Source: main PC vault anchors/
const anchorLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "FELPRA prediction ledger anchor",
  "dateCreated": "2026-11-25T06:30:01+09:00",
  "inLanguage": "en",
  "felpra:anchor": {
    "type": "ledger_anchor",
    "anchor_day": "2026-11-22",
    "latest_chain_hash": "e7a4195f982031bff24b9cce1fc0bb5fa7158e51273b445ad43ac6cbef4e02cf",
    "recipe_version": 1,
    "chain_first_day": "2026-03-22",
    "verify": "Recompute the chain from raw ledger rows using the recipe returned by MCP get_ledger_integrity, then compare against this hash"
  }
};
---
<PostLayout
  title="Ledger Anchor 2026-11-22"
  description="FELPRA prediction ledger weekly integrity anchor. Anchor day 2026-11-22, chain hash e7a4195f…, OpenTimestamps proof included."
  date={new Date('2026-11-25T06:30:01+09:00')}
  category="anchors"
  lang="en"
  altUrl="/anchors/2026-11-22/"
  altLang="ko"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(anchorLd)} />

  <p>This page is the weekly integrity anchor for the FELPRA prediction ledger.
  The hash below is cryptographically linked to the ledger's entire history:
  if any ledger row is edited or deleted after this page was published, a
  recomputed chain hash will diverge from this one. The accompanying
  <code>.ots</code> file proves this hash was timestamped on the Bitcoin
  blockchain (anyone can verify it at
  <a href="https://opentimestamps.org" rel="noopener">opentimestamps.org</a>).</p>

  <table>
    <tbody>
      <tr><th>anchor_day</th><td><code>2026-11-22</code></td></tr>
      <tr><th>latest_chain_hash</th><td><code>e7a4195f982031bff24b9cce1fc0bb5fa7158e51273b445ad43ac6cbef4e02cf</code></td></tr>
      <tr><th>recipe_version</th><td><code>1</code></td></tr>
      <tr><th>chain_first_day</th><td><code>2026-03-22</code></td></tr>
      <tr><th>ledger</th><td><code>mcp_analytics.prediction_ledger_hashes</code></td></tr>
    </tbody>
  </table>

  <h2>Proof file downloads</h2>
  <ul>
    <li><a href="/anchors/anchor_2026-11-22.txt">anchor_2026-11-22.txt</a> — pinned anchor day + chain hash (the OTS-stamped file)</li>
    <li><a href="/anchors/anchor_2026-11-22.txt.ots">anchor_2026-11-22.txt.ots</a> — OpenTimestamps Bitcoin timestamp proof</li>
    <li><a href="/anchors/prediction_ledger_chain_2026-11-22.csv">prediction_ledger_chain_2026-11-22.csv</a> — chain CSV snapshot as of the anchor day (2026-03-22 – 2026-11-22)</li>
  </ul>

  <h2>How to verify</h2>
  <ol>
    <li><strong>Timestamp</strong>: <code>ots verify anchor_2026-11-22.txt.ots</code>
      (or verify on the web at <a href="https://opentimestamps.org" rel="noopener">opentimestamps.org</a>) —
      confirms on the Bitcoin blockchain that this hash existed around this date.</li>
    <li><strong>Chain integrity</strong>: using the recipe returned by FELPRA MCP
      <code>get_ledger_integrity</code>, recompute the hash chain from the raw ledger rows and
      check that the last row's <code>chain_hash</code> matches <code>e7a4195f…</code> above.</li>
    <li><strong>Publication time</strong>: confirm the publication time from a third-party
      record via this page's Wayback Machine archive.</li>
  </ol>
</PostLayout>
