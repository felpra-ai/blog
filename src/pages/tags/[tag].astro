---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { tagPaths } from '../../components/tagPages';

export async function getStaticPaths() {
  return tagPaths('ko');
}

const { tag, posts } = Astro.props;
const koHref = new URL(`/tags/${tag}/`, Astro.site).href;
const enHref = new URL(`/en/tags/${tag}/`, Astro.site).href;
---
<BaseLayout title={`#${tag} — FELPRA`} description={`FELPRA 의 #${tag} 태그 글 목록.`} lang="ko">
  <link rel="alternate" hreflang="ko" href={koHref} slot="head" />
  <link rel="alternate" hreflang="en" href={enHref} slot="head" />
  <link rel="alternate" hreflang="x-default" href={enHref} slot="head" />
  <section class="head container-wide">
    <p class="eyebrow">태그</p>
    <h1>#{tag}</h1>
    <p class="muted">{posts.length}건</p>
  </section>
  <section class="feed container-wide">
    {posts.length === 0 ? (
      <p class="muted">이 태그의 한국어 글은 아직 없습니다.</p>
    ) : (
      <div class="grid">
        {posts.map((p) => (
          <PostCard href={`/${p._collection}/${p.slug}/`} title={p.data.title} description={p.data.description} date={p.data.date} category={p._collection} markets={p.data.markets} tags={p.data.tags} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
<style>
  .head { padding: 56px 24px 20px; }
  .head h1 { font-size: clamp(28px,4vw,40px); font-weight:700; margin:10px 0; color:var(--text); }
  .feed { padding: 12px 24px 24px; }
  .grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(280px,1fr)); gap:16px; }
</style>
