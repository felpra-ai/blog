---
// spotlight 목록 (KO). 본문·문구는 SectionPage.
import SectionPage from '../../components/SectionPage.astro';
import { entries } from '../../components/feedData';

export async function getStaticPaths({ paginate }: { paginate: any }) {
  return paginate(await entries('ko', ['spotlight']), { pageSize: 36 });
}
const { page } = Astro.props;
---
<SectionPage col="spotlight" lang="ko" page={page} />
